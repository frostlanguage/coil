new file mode 100644
index 0000000000000000000000000000000000000000..e75e3592b6835251dd221333bbfcdd2d59ce3d18
--- /dev/null
+++ b/.github/actions/verified-download/action.yml
@@ -0,0 +1,180 @@
+# SPDX-FileCopyrightText: © 2026 Rafael V. Volkmer <rafael.v.volkmer@gmail.com>
+# SPDX-License-Identifier: GPL-3.0-only
+
+---
+name: Verified tool download
+description: Restore or download one immutable tool artifact and verify SHA-256.
+
+inputs:
+  name:
+    description: Stable tool identifier used in the cache key.
+    required: true
+  version:
+    description: Tool version used in the cache key.
+    required: true
+  origin:
+    description: HTTPS origin hosting the immutable artifact.
+    required: true
+  directory:
+    description: Directory below the origin containing the artifact.
+    required: true
+  sha256:
+    description: Expected lowercase SHA-256 digest.
+    required: true
+  filename:
+    description: Artifact filename stored in the cache.
+    required: true
+
+outputs:
+  path:
+    description: Absolute path to the verified artifact.
+    value: ${{ steps.fetch.outputs.path }}
+  source:
+    description: runner-local, github-cache, local-reuse, origin-proxy, or origin.
+    value: ${{ steps.fetch.outputs.source }}
+
+runs:
+  using: composite
+  steps:
+    - name: Compute immutable cache identity
+      id: paths
+      shell: bash
+      env:
+        TOOL_NAME: ${{ inputs.name }}
+        TOOL_VERSION: ${{ inputs.version }}
+        TOOL_SHA256: ${{ inputs.sha256 }}
+        TOOL_FILENAME: ${{ inputs.filename }}
+      run: |
+        set -euo pipefail
+
+        local_cache=false
+        cache_root="${RUNNER_TEMP}/coil-tool-cache"
+
+        if [[ -n "${COIL_CI_TOOL_CACHE_DIR:-}" ]]; then
+          if [[ "${COIL_CI_TOOL_CACHE_DIR}" != /* ]]; then
+            printf '%s\n' 'COIL_CI_TOOL_CACHE_DIR must be absolute.' >&2
+            exit 1
+          fi
+          local_cache=true
+          cache_root="${COIL_CI_TOOL_CACHE_DIR}"
+        fi
+
+        cache_directory="${cache_root}/${RUNNER_OS}/${RUNNER_ARCH}"
+        cache_directory+="/${TOOL_NAME}/${TOOL_VERSION}/${TOOL_SHA256}"
+        artifact_path="${cache_directory}/${TOOL_FILENAME}"
+        cache_key="coil-tool-v2-${RUNNER_OS}-${RUNNER_ARCH}-${TOOL_NAME}"
+        cache_key+="-${TOOL_VERSION}-${TOOL_SHA256}"
+
+        printf 'directory=%s\n' "${cache_directory}" >> "${GITHUB_OUTPUT}"
+        printf 'path=%s\n' "${artifact_path}" >> "${GITHUB_OUTPUT}"
+        printf 'cache_key=%s\n' "${cache_key}" >> "${GITHUB_OUTPUT}"
+        printf 'local_cache=%s\n' "${local_cache}" >> "${GITHUB_OUTPUT}"
+
+    - name: Restore immutable tool artifact
+      id: github_cache
+      if: >-
+        github.event_name != 'release' &&
+        !startsWith(github.ref, 'refs/tags/')
+      uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+      with:
+        path: ${{ steps.paths.outputs.directory }}
+        key: ${{ steps.paths.outputs.cache_key }}
+        lookup-only: ${{ steps.paths.outputs.local_cache == 'true' }}
+
+    - name: Fetch and verify artifact
+      id: fetch
+      shell: bash
+      env:
+        TOOL_NAME: ${{ inputs.name }}
+        TOOL_VERSION: ${{ inputs.version }}
+        TOOL_ORIGIN: ${{ inputs.origin }}
+        TOOL_DIRECTORY: ${{ inputs.directory }}
+        TOOL_FILENAME: ${{ inputs.filename }}
+        TOOL_SHA256: ${{ inputs.sha256 }}
+        ARTIFACT_PATH: ${{ steps.paths.outputs.path }}
+        RUNNER_LOCAL_CACHE: ${{ steps.paths.outputs.local_cache }}
+        GITHUB_CACHE_HIT: ${{ steps.github_cache.outputs.cache-hit }}
+      run: |
+        set -euo pipefail
+
+        mkdir --parents "$(dirname -- "${ARTIFACT_PATH}")"
+        tool_url="${TOOL_ORIGIN%/}/${TOOL_DIRECTORY#/}/${TOOL_FILENAME}"
+
+        valid=false
+        source=origin
+
+        if [[ -f "${ARTIFACT_PATH}" ]]; then
+          if printf '%s  %s\n' \
+            "${TOOL_SHA256}" \
+            "${ARTIFACT_PATH}" \
+            | sha256sum --check --strict --status; then
+            valid=true
+            if [[ "${RUNNER_LOCAL_CACHE}" == true ]]; then
+              source=runner-local
+            elif [[ "${GITHUB_CACHE_HIT}" == true ]]; then
+              source=github-cache
+            else
+              source=local-reuse
+            fi
+          else
+            rm --force "${ARTIFACT_PATH}"
+          fi
+        fi
+
+        if [[ "${valid}" != true ]]; then
+          temporary="${ARTIFACT_PATH}.tmp.${GITHUB_RUN_ID}.${GITHUB_RUN_ATTEMPT}"
+          temporary+=".${GITHUB_JOB}.${RANDOM}"
+          trap 'rm --force "${temporary}"' EXIT
+
+          curl \
+            --fail \
+            --silent \
+            --show-error \
+            --location \
+            --retry 3 \
+            --retry-all-errors \
+            --proto '=https' \
+            --tlsv1.2 \
+            "${tool_url}" \
+            --output "${temporary}"
+
+          printf '%s  %s\n' \
+            "${TOOL_SHA256}" \
+            "${temporary}" \
+            | sha256sum --check --strict
+
+          mv --force "${temporary}" "${ARTIFACT_PATH}"
+          trap - EXIT
+
+          if [[ -n "${HTTPS_PROXY:-${https_proxy:-}}" || \
+                -n "${HTTP_PROXY:-${http_proxy:-}}" ]]; then
+            source=origin-proxy
+          fi
+        fi
+
+        printf '%s  %s\n' \
+          "${TOOL_SHA256}" \
+          "${ARTIFACT_PATH}" \
+          | sha256sum --check --strict
+
+        printf 'path=%s\n' "${ARTIFACT_PATH}" >> "${GITHUB_OUTPUT}"
+        printf 'source=%s\n' "${source}" >> "${GITHUB_OUTPUT}"
+        printf -- '- `%s@%s`: `%s`\n' \
+          "${TOOL_NAME}" \
+          "${TOOL_VERSION}" \
+          "${source}" \
+          >> "${GITHUB_STEP_SUMMARY}"
+
+    - name: Publish immutable tool artifact
+      if: >-
+        github.event_name != 'release' &&
+        !startsWith(github.ref, 'refs/tags/') &&
+        steps.github_cache.outputs.cache-hit != 'true' &&
+        ((github.event_name == 'push' &&
+        github.ref_name == github.event.repository.default_branch) ||
+        (github.event_name == 'workflow_dispatch' &&
+        github.ref_name == github.event.repository.default_branch))
+      uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+      with:
+        path: ${{ steps.paths.outputs.directory }}
+        key: ${{ steps.paths.outputs.cache_key }}
