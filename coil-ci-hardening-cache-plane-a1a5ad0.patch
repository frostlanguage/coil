+++ b/.github/actions/cache-plane/action.yml
@@ -0,0 +1,171 @@
+# SPDX-FileCopyrightText: © 2026 Rafael V. Volkmer <rafael.v.volkmer@gmail.com>
+# SPDX-License-Identifier: GPL-3.0-only
+
+---
+name: Configure CI cache plane
+description: Detect runner-near caches and generate safe Bazel cache policy.
+
+inputs:
+  mode:
+    description: disabled, optional, or required. Empty uses the runner setting.
+    required: false
+    default: ""
+
+outputs:
+  enabled:
+    description: Whether at least one runner-near cache layer is configured.
+    value: ${{ steps.configure.outputs.enabled }}
+  bazelrc:
+    description: Generated Bazel rc file with remote-cache policy.
+    value: ${{ steps.configure.outputs.bazelrc }}
+  bazel_write:
+    description: Whether this GitHub event may upload Bazel cache results.
+    value: ${{ steps.configure.outputs.bazel_write }}
+  registry_enabled:
+    description: Whether a runner-near OCI registry is configured.
+    value: ${{ steps.configure.outputs.registry_enabled }}
+  proxy_enabled:
+    description: Whether an HTTP or HTTPS egress proxy is configured.
+    value: ${{ steps.configure.outputs.proxy_enabled }}
+
+runs:
+  using: composite
+  steps:
+    - name: Detect and configure cache plane
+      id: configure
+      shell: bash
+      env:
+        INPUT_MODE: ${{ inputs.mode }}
+        EVENT_NAME: ${{ github.event_name }}
+        REF_NAME: ${{ github.ref_name }}
+        DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
+      run: |
+        set -euo pipefail
+
+        mode="${INPUT_MODE:-${COIL_CI_CACHE_PLANE_MODE:-optional}}"
+
+        case "${mode}" in
+          disabled|optional|required)
+            ;;
+          *)
+            printf 'Invalid cache-plane mode: %s\n' "${mode}" >&2
+            exit 1
+            ;;
+        esac
+
+        proxy_enabled=false
+        registry_enabled=false
+        bazel_enabled=false
+        local_tool_cache=false
+
+        if [[ -n "${HTTPS_PROXY:-${https_proxy:-}}" || \
+              -n "${HTTP_PROXY:-${http_proxy:-}}" ]]; then
+          proxy_enabled=true
+        fi
+
+        registry="${COIL_CI_OCI_REGISTRY:-}"
+        if [[ -n "${registry}" ]]; then
+          if [[ "${registry}" == *://* || "${registry}" == */* ]]; then
+            printf '%s\n' \
+              'COIL_CI_OCI_REGISTRY must be a registry host[:port].' >&2
+            exit 1
+          fi
+          registry_enabled=true
+        fi
+
+        bazel_cache="${COIL_CI_BAZEL_REMOTE_CACHE:-}"
+        if [[ -n "${bazel_cache}" ]]; then
+          case "${bazel_cache}" in
+            http://*|https://*|grpc://*|grpcs://*)
+              bazel_enabled=true
+              ;;
+            *)
+              printf '%s\n' \
+                'COIL_CI_BAZEL_REMOTE_CACHE must use HTTP(S) or gRPC(S).' >&2
+              exit 1
+              ;;
+          esac
+        fi
+
+        if [[ -n "${COIL_CI_TOOL_CACHE_DIR:-}" ]]; then
+          if [[ "${COIL_CI_TOOL_CACHE_DIR}" != /* ]]; then
+            printf '%s\n' 'COIL_CI_TOOL_CACHE_DIR must be absolute.' >&2
+            exit 1
+          fi
+          local_tool_cache=true
+        fi
+
+        enabled=false
+        if [[ "${proxy_enabled}" == true || \
+              "${registry_enabled}" == true || \
+              "${bazel_enabled}" == true || \
+              "${local_tool_cache}" == true ]]; then
+          enabled=true
+        fi
+
+        if [[ "${mode}" == required ]]; then
+          if [[ "${proxy_enabled}" != true || \
+                "${registry_enabled}" != true || \
+                "${bazel_enabled}" != true ]]; then
+            printf '%s\n' \
+              'Required cache plane is missing proxy, registry, or Bazel cache.' \
+              >&2
+            exit 1
+          fi
+        fi
+
+        bazel_write=false
+        if [[ "${EVENT_NAME}" == merge_group ]]; then
+          bazel_write=true
+        elif [[ "${EVENT_NAME}" == push && \
+                "${REF_NAME}" == "${DEFAULT_BRANCH}" ]]; then
+          bazel_write=true
+        elif [[ "${EVENT_NAME}" == workflow_dispatch && \
+                "${REF_NAME}" == "${DEFAULT_BRANCH}" ]]; then
+          bazel_write=true
+        fi
+
+        cache_dir="${RUNNER_TEMP}/coil-cache-plane"
+        bazelrc="${cache_dir}/bazelrc"
+        mkdir --parents "${cache_dir}"
+
+        {
+          printf '%s\n' '# Generated by Coil CI. Do not commit.'
+          if [[ "${bazel_enabled}" == true && "${mode}" != disabled ]]; then
+            printf 'build --remote_cache=%s\n' "${bazel_cache}"
+            printf '%s\n' 'build --remote_verify_downloads=true'
+            printf '%s\n' 'build --remote_timeout=30s'
+            printf 'build --remote_upload_local_results=%s\n' "${bazel_write}"
+
+            if [[ -n "${COIL_CI_BAZEL_REMOTE_INSTANCE:-}" ]]; then
+              printf 'build --remote_instance_name=%s\n' \
+                "${COIL_CI_BAZEL_REMOTE_INSTANCE}"
+            fi
+          fi
+        } > "${bazelrc}"
+
+        printf 'enabled=%s\n' "${enabled}" >> "${GITHUB_OUTPUT}"
+        printf 'bazelrc=%s\n' "${bazelrc}" >> "${GITHUB_OUTPUT}"
+        printf 'bazel_write=%s\n' "${bazel_write}" >> "${GITHUB_OUTPUT}"
+        printf 'registry_enabled=%s\n' \
+          "${registry_enabled}" >> "${GITHUB_OUTPUT}"
+        printf 'proxy_enabled=%s\n' \
+          "${proxy_enabled}" >> "${GITHUB_OUTPUT}"
+
+        {
+          printf '%s\n' '### Coil CI cache plane'
+          printf '\n'
+          printf '| Layer | State |\n'
+          printf '| --- | --- |\n'
+          printf '| Runner-local tool cache | %s |\n' "${local_tool_cache}"
+          printf '| Egress proxy | %s |\n' "${proxy_enabled}"
+          printf '| OCI registry | %s |\n' "${registry_enabled}"
+          if [[ "${bazel_enabled}" == true ]]; then
+            printf '| Bazel remote cache | enabled (%s) |\n' \
+              "$([[ "${bazel_write}" == true ]] && echo read-write || echo read-only)"
+          else
+            printf '%s\n' '| Bazel remote cache | false |'
+          fi
+          printf '\n'
+          printf 'Mode: `%s`. Endpoints are intentionally not logged.\n' "${mode}"
+        } >> "${GITHUB_STEP_SUMMARY}"
