[codespell]
builtin = clear,rare,code
check-filenames =
check-hidden =
count =
ignore-words = tools/lint/spell/cspell/cspell-words.txt
quiet-level = 2
skip = .git,LICENSES,*.lock,*.min.*,*.svg,*.aff,*.dic

# EOF
